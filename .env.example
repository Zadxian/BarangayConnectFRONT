# Copy to .env for local development. Never commit .env.
APP_NAME=BarangayConnect
APP_KEY=replace-with-a-random-64-character-hex-secret
APP_ENV=development
APP_URL=http://127.0.0.1:8000
ADMIN_SETUP_TOKEN=replace-with-a-separate-random-secret

# Aiven MySQL - copy the host, port, database, user, and password from your service details
DB_HOST=
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
# Download the CA certificate from the Aiven service page and save it locally
DB_SSL_CA=runtime/certs/ca.pem

JWT_SECRET=replace-with-a-random-64-character-hex-secret
REFRESH_TOKEN_KEY=replace-with-a-different-random-64-character-hex-secret
JWT_ISSUER=barangayconnect
JWT_AUDIENCE=barangayconnect-web
FRONTEND_ORIGIN=http://localhost:8000

# Optional services; leave blank until accounts and webhook configuration are ready.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
SEMAPHORE_API_KEY=
FIREBASE_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
